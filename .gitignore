# Runtime state — never belongs in the repo, lives in DATA_DIR instead
member_registry.json
revocation_list.json
payment_requests.json
stripe_processed_sessions.json
.config-*.tmp
credentials/
bundles/
cards/

# Secrets — your own keypair, generated per deployment, never shared or committed
keys/

# Local environment / Python
__pycache__/
*.pyc
venv/
.env
.idea/
uploads/

# Backup/restore working files (live in DATA_DIR; only matter when running locally)
backup_state.json
.backup-*.zip
.backup-state-*.tmp
.upload-*.zip
.restore-*/
.replaced-*/
